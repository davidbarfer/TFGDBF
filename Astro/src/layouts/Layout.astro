---
import Header from '@/components/Header.astro';
import jwt from 'jsonwebtoken'
import { parse } from 'cookie';

const cookies = parse(Astro.request.headers.get('cookie') || '');
const token = cookies.token;
const secret = import.meta.env.JWT_SECRET;
let user = null;
if (token) {
  try {
    user = jwt.verify(token, secret); // same secret as backend
  } catch (err) {
    console.warn("Invalid or expired token", err);
  }
}
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="DoctusLite" />
		<title>DoctusLite</title>
	</head>
	<body>
		<Header user={user}/>
		<slot />
	</body>
</html>

<style>
	:root {
		--color-primary: #ff9e18;
		--color-secondary: #D7282F;
		--color-tertiary: #0033a1;
		--color-border: #dddddd;
    --color-background-modal: rgba(221, 221, 221, 0.5);
	}
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	body {
		display: grid;
		grid-template-rows: auto 1fr;
		justify-items: center;
		gap: 1rem;
	}
</style>

<style is:global>
    button {
    padding: 0.5rem;
    background-color: var(--color-primary);
    color: var(--color-tertiary);
    font-weight: bold;
    text-transform: uppercase;
    border: none;
    border-radius: 4px;
    cursor: pointer;
  }
  button:hover {
    background-color: var(--color-secondary);
    transition: background-color 0.3s ease;
  }
	button:disabled {
		cursor: not-allowed;
	}
	table {
    width: fit-content;
    border-collapse: collapse;
    margin: 0 auto;
  }
  th, td {
    border: 1px solid var(--color-border);
    padding: 8px;
    text-align: left;
  }
	input[type="number"] {
		width: 100px;
		padding: 0.5rem;
		border: 1px solid var(--color-border);
		border-radius: 4px;
	}
  input[type="number"]:disabled {
    border-color: var(--color-secondary);
    color: var(--color-secondary);
    cursor: not-allowed;
    opacity: 0.7;
    /* Remove spinner arrows for disabled state */
    -moz-appearance: textfield;
  }

  /* Chrome, Safari, Edge, Opera - disabled state */
  input[type="number"]:disabled::-webkit-outer-spin-button,
  input[type="number"]:disabled::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
</style>
