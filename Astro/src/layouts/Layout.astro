---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import jwt from 'jsonwebtoken'
import { parse } from 'cookie';

const cookies = parse(Astro.request.headers.get('cookie') || '');
const token = cookies.token;
const secret = import.meta.env.JWT_SECRET;
let user = null;
if (token) {
  try {
    user = jwt.verify(token, secret); // same secret as backend
  } catch (err) {
    console.warn("Invalid or expired token", err);
  }
}
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="DoctusLite" />
		<title>DoctusLite</title>
	</head>
	<body>
		<Header user={user}/>
		<slot />
		<Footer />
	</body>
</html>

<style>
	:root {
		--color-primary: #ff9e18;
		--color-secondary: #D7282F;
		--color-tertiary: #0033a1;
	}
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	body {
		display: grid;
		grid-template-rows: auto 1fr auto;
		place-items: center;
	}
</style>
