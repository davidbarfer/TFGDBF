---
import  Modal  from '@/components/utils/Modal.astro';
import Spinner from '@/components/utils/Spinner.astro';
const { subjectId, submission, token } = Astro.props;
const currentPath = Astro.url.pathname;
---
<section class="actionsSubmision">
  <Modal id=`gradeModal${submission.id}` btnText="Calificar">
    <main slot="mainModal">
      <p>Está acción va a copiar la nota del evaluador en la nota del alumno y la hará pública para el alumno.</p>
      <p>Si quiere editar manualmente la nota del alumno haga click en el botón de editar</p>
      <button 
        id=`gradeBtn${submission.id}` 
        class="gradeBtn"
        data-submission_id={submission.id} 
        data-user_id={submission.user_id} 
        data-token={token} 
        data-evaluator_grade={submission.evaluator_grade}
      >
        Aceptar
      </button>
    </main>
    <button slot="closeModal">Cancelar</button>
  </Modal>
  <Modal id=`evaluatorModal${submission.id}` btnText="Ejecutar evaluador">
    <main slot="mainModal">
      <p>Está acción ejecutara el evaluador y si no hay ningun error generara una nota en Nota del evaluador</p>
      <p>Ejecuta el evaluador consume recursos del sistema, por favor tengalo en cuenta</p>
      <p>Esta pendiente implementar un sistema de notificación, no se preocupe, el sistema se esta ejecutado</p>
      <section>
        <Spinner id=`evaluatorSpinner${submission.id}`/>
        <button 
          id = `evaluatorBtn${submission.id}` 
          class="evaluatorBtn"
          data-token={token} 
          data-user_id={submission.user_id} 
          data-submission_id={submission.id} 
        >
          Aceptar
        </button>
      </section>
  </main>
  <button slot="closeModal">Cancelar</button>
  </Modal>
  <a href={`/asignaturas/${subjectId}/practicas/${submission.practice_id}/entregas/${submission.id}/edit?redirect=${encodeURIComponent(currentPath)}`}><button>Editar</button></a>
</section>

<script>
  import { actions } from 'astro:actions';
  import { showToastOnLoad, TOASTSTYLE } from "@/utils/toaster";
  const gradeBtns = document.getElementsByClassName('gradeBtn')
  const evaluatorBtns = document.getElementsByClassName('evaluatorBtn')
  const spinners = document.getElementsByClassName('spinner-container');
  Array.from(gradeBtns).forEach(gradeBtn => gradeBtn.addEventListener('click', async () => {
    const token = gradeBtn?.dataset.token;
    const url_data = {
      user_id: gradeBtn?.dataset.user_id as string,
      submission_id: gradeBtn?.dataset.submission_id as string,
      evaluator_grade: gradeBtn?.dataset.evaluator_grade as string,
    }
    const { data, error } = await actions.professor.gradeSubmissionStudent({
      token: token as string,
      url_data: url_data
    })
    if(error) {
      showToastOnLoad(error.message, TOASTSTYLE.error);
    }
    window.location.reload();
  }))
  Array.from(evaluatorBtns).forEach(evaluatorBtn => evaluatorBtn.addEventListener('click', async() => {
    const spinner = spinners.item(evaluatorBtn?.dataset.submission_id - 1) as HTMLElement;
    evaluatorBtn?.classList.toggle('toggleSendBtn');
    spinner?.classList.toggle('toggleVisiblity');
    const token = evaluatorBtn?.dataset.token;
    const url_data = {
      user_id: evaluatorBtn?.dataset.user_id as string,
      submission_id: evaluatorBtn?.dataset.submission_id as string,
    }
    const { data, error } = await actions.professor.executeSubmssionEvaluator({
      token: token as string,
      url_data: url_data
    })
    try {
      if(error) {
        showToastOnLoad(error.message, TOASTSTYLE.error);
      } else {
        showToastOnLoad('Evaluador ejecutado', TOASTSTYLE.success);
      }
      const lastOpenedSubjectId = localStorage.getItem('openSubject');
      if (lastOpenedSubjectId) {
        window.location.href = `${window.location.pathname}#subject-${lastOpenedSubjectId}`;
        window.location.reload();
      } else {
        window.location.reload();
      }
    } finally {
      spinner?.classList.toggle('toggleVisiblity');
      evaluatorBtn?.classList.toggle('toggleSendBtn');
    }
  }))
</script>

<style scoped>
  .actionsSubmision {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .toggleSendBtn {
    display: none !important;
  }
  </style>