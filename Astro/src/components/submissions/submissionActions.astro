---
import  Modal  from '@/components/Modal.astro';
const { subjectId, submission, token } = Astro.props;
---
<section class="actionsSubmision">
  <Modal id=`gradeModal${submission.id}` btnText="Calificar">
    <main slot="mainModal">
      <p>Está acción va a copiar la nota del evaluador en la nota del alumno y la hará pública para el alumno.</p>
      <p>Si quiere editar manualmente la nota del alumno haga click en el botón de editar</p>
      <button 
        id=`gradeBtn${submission.id}` 
        class="gradeBtn"
        data-submission_id={submission.id} 
        data-user_id={submission.user_id} 
        data-token={token} 
        data-evaluator_grade={submission.evaluator_grade}
      >
        Aceptar
      </button>
    </main>
    <button slot="closeModal">Cancelar</button>
  </Modal>
  <button 
    class="evaluatorBtn"
    data-token={token} 
    data-user_id={submission.user_id} 
    data-submission_id={submission.id} 
  >
    Ejecutar evaluador
  </button>
  <a href={`/asignaturas/${subjectId}/practicas/${submission.practice_id}/entregas/${submission.id}/edit`}><button>Editar</button></a>
</section>

<script>
  import { actions } from 'astro:actions';
  const gradeBtns = document.getElementsByClassName('gradeBtn')
  const evaluatorBtns = document.getElementsByClassName('evaluatorBtn')
  Array.from(gradeBtns).forEach(gradeBtn => gradeBtn.addEventListener('click', async () => {
    const token = gradeBtn?.dataset.token;
    const url_data = {
      user_id: gradeBtn?.dataset.user_id as string,
      submission_id: gradeBtn?.dataset.submission_id as string,
      evaluator_grade: gradeBtn?.dataset.evaluator_grade as string,
    }
    const { data, error } = await actions.professor.gradeSubmissionStudent({
      token: token as string,
      url_data: url_data
    })
    if(error) {
      alert(error.message);
    }
    window.location.reload();
  }))
  Array.from(evaluatorBtns).forEach(evaluatorBtn => evaluatorBtn.addEventListener('click', async() => {
    const token = evaluatorBtn?.dataset.token;
    const url_data = {
      user_id: evaluatorBtn?.dataset.user_id as string,
      submission_id: evaluatorBtn?.dataset.submission_id as string,
    }
    const { data, error } = await actions.professor.executeSubmssionEvaluator({
      token: token as string,
      url_data: url_data
    })
    if(error) {
      alert(error.message);
    }
    console.log('Evaluador ejecutado');
  }))
</script>

<style scoped>
  .actionsSubmision {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  </style>