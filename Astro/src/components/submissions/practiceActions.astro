---
import jwt from 'jsonwebtoken'
import Modal from '@/components/utils/Modal.astro';

const secret = import.meta.env.JWT_SECRET;
const { token , practice } = Astro.props;
let user = null;
if (token) {
  try {
    user = jwt.verify(token, secret); // same secret as backend
  } catch (err) {
    console.warn("Token no válido o vencido", err);
  }
}
const isEvaluator = !practice.evaluator_template_url;
---

<section>
  <Modal id={`createSubmissionsModal${practice.id}`} btnText="Crear Entregas">
    <main slot="mainModal">
      <h1>Crear Entregas</h1>
      <h2>Práctica {practice.name}</h2>
      <p>Va a crear una entrega por cada alumno que tenga asignado un grupo</p>
      <p>La fecha de entrega será la fecha del grupo + 7 días naturales</p>
      <button id={`createSubmissionsBtn${practice.id}`} data-token={token} data-practice_id={practice.id} data-create-submissions-btn>Aceptar</button>
    </main>
    <button slot="closeModal">Cancelar</button>
  </Modal>
  <button>
    <a href={`/asignaturas/${practice.subject_id}/practicas/${practice.id}/evauladores/crear`}>{isEvaluator ? 'Crear evaulador' : 'Editar Evaluador'}</a>
  </button>
  <button id={`downloadPracticeGrades${practice.id}`} data-download-practice-grades-btn data-token={token} data-practice_id={practice.id}>Descargar Notas</button>
</section>

<style scoped>
  section {
    display: flex;
    flex-direction: row;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    padding-block: 1rem;
  }
  a {
    text-decoration: none;
    color: inherit;
  }
</style>

<script>
  import { actions } from "astro:actions";
  import { showToast, showToastOnLoad, TOASTSTYLE } from "@/utils/toaster";
  const createSubmissionsBtns = document.querySelectorAll('[data-create-submissions-btn]');
  const downloadPracticeGradesBtns = document.querySelectorAll('[data-download-practice-grades-btn]');
  createSubmissionsBtns?.forEach((createSubmissionsBtn) => {
    createSubmissionsBtn?.addEventListener('click',async () => {
      const token = createSubmissionsBtn?.dataset.token;
      const practice_id = createSubmissionsBtn?.dataset.practice_id;
      const { data: response, error: responseError } = await actions.professor.createSubmissions({ token: token as string, practice_id: String(practice_id) });
      if(responseError) {
        const modal = document.getElementById(`createSubmissionsModal${practice_id}`) as HTMLDialogElement;
        modal?.close()
        showToast(responseError.message, TOASTSTYLE.error);
      }
      else {
        showToastOnLoad('Entregas creadas', TOASTSTYLE.success);
        window.location.reload();
      }
    });
  })
  downloadPracticeGradesBtns?.forEach((downloadGradesBtn) => {
    downloadGradesBtn?.addEventListener('click', async () => {
      const token = downloadGradesBtn?.dataset.token;
      const practice_id = downloadGradesBtn?.dataset.practice_id;
      const { data: response, error:  responseError } = await actions.professor.downloadPracticeGrades({ token: token as string, practice_id: String(practice_id)})
      if(responseError) showToast(responseError.message, TOASTSTYLE.error)
      if(response) {
        // 1. Convertimos el string de texto plano a un objeto binario (Blob) indicando que es un CSV
        const blob = new Blob([response as string], { type: 'text/csv;charset=utf-8;' });
        // 2. Creamos el enlace temporal para forzar la descarga en el navegador
        const url = window.URL.createObjectURL(blob);
        const downloadAnchor = document.createElement('a');
        downloadAnchor.href = url;
        downloadAnchor.download = `practica_${practice_id}_notas.csv`;
        document.body.appendChild(downloadAnchor);
        downloadAnchor.click();
        // 3. Limpieza
        document.body.removeChild(downloadAnchor);
        window.URL.revokeObjectURL(url);
        showToast('Descarga procesada', TOASTSTYLE.success);
      }
    })
  })
</script>