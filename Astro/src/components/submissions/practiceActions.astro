---
import jwt from 'jsonwebtoken'
import Modal from '@/components/Modal.astro';

const secret = import.meta.env.JWT_SECRET;
const { token , practice } = Astro.props;
let user = null;
if (token) {
  try {
    user = jwt.verify(token, secret); // same secret as backend
  } catch (err) {
    console.warn("Invalid or expired token", err);
  }
}
---

<section>
  <Modal id="createSubmissionsModal" btnText="Crear Entregas">
    <main slot="mainModal">
      <h1>Crear Entregas</h1>
      <h2>Práctica {practice.name}</h2>
      <p>Va a crear una entrega por cada alumno que tenga asignado un grupo</p>
      <p>La fecha de entrega será la fecha del grupo + 7 días naturales</p>
      <button id="createSubmissionsBtn" data-token={token} data-practice_id={practice.id}>Aceptar</button>
    </main>
    <button slot="closeModal">Cancelar</button>
  </Modal>
  <button>
    <a href={`/asignaturas/${practice.subject_id}/practicas/${practice.id}/evauladores/crear`}>Crear evaulador</a>
  </button>
  <button disabled>Ejecutar evaluador</button>
  <button disabled>Calificar</button>
</section>

<style scoped>
  section {
    display: flex;
    flex-direction: row;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    padding-block: 1rem;
  }
  a {
    text-decoration: none;
    color: inherit;
  }
</style>

<script>
  import { actions } from "astro:actions";
  const createSubmissionsBtn = document.getElementById('createSubmissionsBtn');
  createSubmissionsBtn?.addEventListener('click',async () => {
    const token = createSubmissionsBtn?.dataset.token;
    const practice_id = createSubmissionsBtn?.dataset.practice_id;
    const { data: response, error: responseError } = await actions.professor.createSubmissions({ token: token as string, practice_id: String(practice_id) });
    if(responseError) {
      alert(responseError.message);
    }
    else {
      alert('Entregas creadas');
      window.location.reload();
    }
  });
</script>