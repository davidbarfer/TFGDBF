---
import jwt from 'jsonwebtoken'
import { actions } from 'astro:actions';
import { submissionStatus} from "@/consts/submissions";
import Error from '../utils/Error.astro';
const secret = import.meta.env.JWT_SECRET;
const { userId, token } = Astro.props;
let user = null;
if (token) {
  try {
    user = jwt.verify(token, secret); // same secret as backend
  } catch (err) {
    console.warn("Invalid or expired token", err);
  }
}
const { data: submissions, error: submissionsError } = await Astro.callAction(actions.user.getStudentSubmissions, { token: token as string, user_id: String(userId) });
---
<section>
  <h1>Entregas del alumno {userId}</h1>
  {submissionsError ? (
    <Error message={submissionsError.message} />
  ) : (
    <table>
    <thead>
      <tr>
        <th>Entrega</th>
        <th>Practica</th>
        <th>Fecha de entrega</th>
        <th>Nota</th>
        <th>Estado</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      {submissions?.map((submission : any) => (
        <tr>
          <td>{submission.id}</td>
          <td>{submission.practice_name}</td>
          <td>{new Date(submission.delivery_date).toLocaleDateString('es-ES', { year: 'numeric', month: '2-digit', day: '2-digit' })}</td>
          <td>{submission.grade}</td>
          <td><p class="status">{submissionStatus(submission.grade, submission.delivery_date, submission.file_url)}</p></td>
          <td><a href={`/asignaturas/${submission.subject_id}/practicas/${submission.practice_id}/entregas/${submission.id}`}><button>Ver</button></a></td>
        </tr>
      ))}
    </tbody>
  </table>
  )}
</section>

<style scoped>
.status {
  text-transform: uppercase;
  font-weight: bold;
  color: var(--color-tertiary);
}
</style>