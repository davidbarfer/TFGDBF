---
import { submissionStatuses,submissionStatus } from "@/consts/submissions";
const submission = Astro.props.submission;
---

<section>
  <form id="submission-form">
    <label for="entrega">Tu entrega</label>
    <textarea id="entrega" name="entrega" required rows="8" cols="50" data-code={submission.template}>{submission.template}</textarea>
    {submissionStatuses.pending === submissionStatus(submission.grade, submission.delivery_date) ? (
      <button type="submit">Enviar</button>
    ) : (
      <button type="submit" disabled>{submissionStatus(submission.grade, submission.delivery_date)}</button>
    )}
  </form>
</section>

<script></script>

<style>
  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  textarea {
    resize: none;
  }
</style>
