---
import Spinner from "@/components/utils/Spinner.astro";
import { submissionStatuses,submissionStatus } from "@/consts/submissions";
const {submission, token} = Astro.props;
---

<section>
  <form id="submissionForm" data-submission={JSON.stringify(submission)} data-token={token}>
    <label for="fileContent">Tu entrega</label>
    <textarea id="fileContent" name="fileContent" required rows="8" cols="50" data-code={submission.file_content}>{submission.file_content}</textarea>
    {submissionStatuses.pending === submissionStatus(submission.grade, submission.delivery_date, submission.file_url) ? (
      <section class="submitForm">
        <button type="submit" id="submitSubmissionFormBtn">Enviar</button>
        <Spinner/>
      </section>
    ) : (
      <button type="submit" disabled>{submissionStatus(submission.grade, submission.delivery_date, submission.file_url)}</button>
    )}
  </form>
</section>

<script>
  import { actions } from "astro:actions";
  import { showToast, showToastOnLoad, TOASTSTYLE } from "@/utils/toaster";
  const form = document.getElementById('submissionForm');
  const spinner = document.querySelector('.spinner-container') as HTMLElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = document.getElementById('submitSubmissionFormBtn');
    submitBtn?.classList.toggle('toggleSendBtn')
    spinner?.classList.toggle('toggleVisiblity')
    const submission = JSON.parse(form.dataset.submission || '{}');
    const token = form.dataset.token;
    const formData = new FormData(e.target);
    const data = {
      token: token as string,
      file_content: formData.get('fileContent') as string,
      url_params: {
        creation_date: new Date().toISOString(),
        user_id: String(submission?.user_id),
        subject_id: String(submission?.subject_id),
        practice_id: String(submission?.practice_id),
        submission_id: String(submission?.id),
      },
    }
    const response = await actions.user.saveSubmissionFile(data);
    try{
      if(response.error) {
        showToast(`Error al realizar la entrega: ${response.error}`, TOASTSTYLE.error)
      }
      if (response.data) {
        showToastOnLoad('Entrega realizada', TOASTSTYLE.success);
        window.location.href = `/entregas/`;
      }
    } finally {
      submitBtn?.classList.toggle('toggleSendBtn')
      spinner?.classList.toggle('toggleVisiblity')
    }
  });
</script>

<style>
  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  textarea {
    resize: none;
  }
  .submitForm {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .toggleSendBtn {
    display: none !important;
  }
</style>
