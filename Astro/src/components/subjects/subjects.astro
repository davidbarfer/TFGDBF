---
import { actions } from 'astro:actions';
import Error from "@/components/utils/Error.astro";
const { token } = Astro.props;
const { data: subjects, error: subjectsError } = await Astro.callAction(actions.user.getSubjectsUser, { token: token as string });
---
{subjectsError ? (<Error message={subjectsError?.message} />) : (
  <table>
    <thead>
      <tr>
        <th>Nombre</th>
        <th>Curso</th>
        <th>Grado</th>
      </tr>
    </thead>
    <tbody>
      {subjects.map(subject => (
        <tr>
          <td><a href={`/asignaturas/${subject.id}`}>{subject.name}</a></td>
          <td>{subject.course}</td>
          <td>{subject.degree}</td>
        </tr>
      ))}
    </tbody>
  </table>
)}
<style>
  table {
    width: fit-content;
    border-collapse: collapse;
    margin: 0 auto;
  }
  th, td {
    border: 1px solid #ddd;
    padding: 8px;
    text-align: left;
  }
</style>