---
import { actions } from "astro:actions";
const {token, users} = Astro.props
const { data: subjects, error: subjectsError } = await Astro.callAction(actions.user.getSubjects, {token})
---
<section class="assignTableSection">
  <input type="text" id="searchNames" placeholder="Filtra por nombres, DNI o apellidos.." data-search-names>
  <table id="AssignTable" data-assign-table>
    <thead>
      <tr>
        <th>Nombre de Usuario (DNI)</th>
        <th>Nombre</th>
        <th>Apellidos</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      {users?.map((user : any) => (
        <tr>
        <td>{user.username}</td>
        <td>{user.name}</td>
        <td>{user.surname}</td>
        <td class="formSection">
          <form id={`AddSubjectForm${user.id}`} data-userId = {user.id} data-token={token} data-add-subject-form>
            {subjects.filter((subject: any) => !user.subjects_id?.includes(subject.id)).length === 0 ? (
              <select name="subject_id" disabled>
                <option>Todas las asignaturas asignadas</option>
              </select>
                <button type="submit" disabled>
                  Asignar
                </button>
            ) : (
              <select name="subject_id">
                {subjects
                  .filter((subject: any) => !user.subjects_id?.includes(subject.id))
                  .map((subject: any) => (
                  <option value={subject.id}>{subject.name} ({subject.degree})</option>
                ))}
              </select>
              <button type="submit">Asignar</button>
            )}
          </form>
          <form id={`DeleteSubjectForm${user.id}`} data-userId = {user.id} data-token={token} data-delete-subject-form>
            {subjects.filter((subject: any) => user.subjects_id?.includes(subject.id)).length === 0 ? (
              <select name="subject_id" disabled>
                <option>Ninguna asignatura asignada</option>
              </select>
                <button type="submit" disabled>
                  Desasignar
                </button>
            ) : (
              <select name="subject_id">
                {subjects
                  .filter((subject: any) => user.subjects_id?.includes(subject.id))
                  .map((subject: any) => (
                  <option value={subject.id}>{subject.name} ({subject.degree})</option>
                ))}
              </select>
              <button type="submit">Desasignar</button>
            )}
          </form>
        </td>
      </tr>
      ))}
    </tbody>
  </table>
</section>
<script>
  import { actions } from "astro:actions";
  import { showToast, showToastOnLoad, TOASTSTYLE } from "@/utils/toaster";
  const AddSubjectForms = document.querySelectorAll('[data-add-subject-form]');
  const DeleteSubjectForms = document.querySelectorAll('[data-delete-subject-form]');
  AddSubjectForms?.forEach((AddSubjectForm) => {
    AddSubjectForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const token = AddSubjectForm.dataset.token;
      const user_id = AddSubjectForm.dataset.userid;
      const formData = new FormData(e.target);
      const subject_id = formData.get('subject_id');
      const { data: response, error: responseError } = await actions.professor.assignUserSubject({ token: token as string, user_id: Number(user_id), subject_id: Number(subject_id)})  
      if(responseError) {
        showToast(responseError.message, TOASTSTYLE.error);
      } else {
        showToastOnLoad(response.message, TOASTSTYLE.success)
        window.location.reload();
      }
    })
  })
  DeleteSubjectForms?.forEach((DeleteSubjectForm) => {
    DeleteSubjectForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const token = DeleteSubjectForm.dataset.token;
      const user_id = DeleteSubjectForm.dataset.userid;
      const formData = new FormData(e.target);
      const subject_id = formData.get('subject_id');
      const { data: response, error: responseError } = await actions.professor.unassignUserSubject({ token: token as string, user_id: Number(user_id), subject_id: Number(subject_id)})  
      if(responseError) {
        showToast(responseError.message, TOASTSTYLE.error);
      } else {
        showToastOnLoad(response.message, TOASTSTYLE.success)
        window.location.reload();
      }
    })
  })
</script>

<script>
  const searchInputs = document.querySelectorAll('[data-search-names]');
  const tables = document.querySelectorAll('[data-assign-table]');
  searchInputs?.forEach((searchInput, index) => {
    const table = tables[index]
    searchInput?.addEventListener('input', () => {
      const filter = searchInput.value.toLowerCase().trim();
      const rows = table?.querySelectorAll("tbody tr");
      
      rows?.forEach((row) => {
        const cells = row.querySelectorAll("td");
        // Check DNI (col 0), Name (col 1), and Surname (col 2)
        const username = cells[0]?.textContent?.toLowerCase() || "";
        const name = cells[1]?.textContent?.toLowerCase() || "";
        const surname = cells[2]?.textContent?.toLowerCase() || "";
        
        // Show row if query matches username, name, surname, or full name
        const fullName = `${name} ${surname}`;
        const matches = username.includes(filter) || name.includes(filter) || surname.includes(filter) || fullName.includes(filter);
        
        (row as HTMLElement).style.display = matches ? "" : "none";
      });
    });
  })
</script>
<style>
  .assignTableSection {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }
  table {
    width: 100%;
  }
  .formSection {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  form {
    display: flex;
    gap: 1rem;
  }
  
</style>