---
import { actions } from "astro:actions";
const {token} = Astro.props
let { data: professors, error: professorsError} = await Astro.callAction(actions.professor.getUsersProfessors,{token: token as string});
const { data: subjects, error: subjectsError } = await Astro.callAction(actions.user.getSubjects, {token})
---

<section>
  <h1>Asignar profesor a sus asignaturas</h1>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Surname</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      {professors.map((professor : any) => (
        <tr>
        <td>{professor.name}</td>
        <td>{professor.surname}</td>
        <td>
          <form id={`AddSubjectForm${professor.id}`}>
          <select>
            {subjects
              .filter((subject: any) => !professor.subjects_id?.includes(subject.id))
              .map((subject: any) => (
                <option value={subject.id}>{subject.name}</option>
            ))}
          </select>
          <button type="submit">Añadir asignatura</button>
          </form>
        </td>
      </tr>
  ))}
    </tbody>
  </table>
</section>