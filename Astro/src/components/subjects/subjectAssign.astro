---
import { actions } from "astro:actions";
const {token, users} = Astro.props
const { data: subjects, error: subjectsError } = await Astro.callAction(actions.user.getSubjects, {token})
---

  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Surname</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      {users.map((user : any) => (
        <tr>
        <td>{user.name}</td>
        <td>{user.surname}</td>
        <td>
          <form id={`AddSubjectForm${user.id}`} data-userId = {user.id} data-token={token}>
            {subjects.filter((subject: any) => !user.subjects_id?.includes(subject.id)).length === 0 ? (
              <select name="subject_id" disabled>
                <option>Todas las asignaturas asignadas</option>
              </select>
                <button type="submit" disabled>
                  Añadir asignatura
                </button>
            ) : (
              <select name="subject_id">
                {subjects
                  .filter((subject: any) => !user.subjects_id?.includes(subject.id))
                  .map((subject: any) => (
                  <option value={subject.id}>{subject.name} ({subject.degree})</option>
                ))}
              </select>
              <button type="submit">Añadir asignatura</button>
            )}
          </form>
        </td>
      </tr>
      ))}
    </tbody>
  </table>

<script>
  import { actions } from "astro:actions";
  const AddSubjectForms = document.getElementsByTagName('form');
  Object.entries(AddSubjectForms).forEach(AddSubjectForm => {
    const form = AddSubjectForm[1]
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const token = form.dataset.token;
      const user_id = form.dataset.userid;
      const formData = new FormData(e.target);
      const subject_id = formData.get('subject_id');
      const { data: response, error: responseError } = await actions.professor.assignUserSubject({ token: token as string, user_id: Number(user_id), subject_id: Number(subject_id)})  
      if(responseError) {
        alert(responseError);
      } else {
        alert(response.message)
        window.location.reload();
      }
  })
  })
</script>

<style>
  table {
    width: 100%;
  }
</style>