---
import { actions } from 'astro:actions';
import jwt from 'jsonwebtoken'
const secret = import.meta.env.JWT_SECRET;
const { subject, token } = Astro.props;
let user = null;
if (token) {
  try {
    user = jwt.verify(token, secret); // same secret as backend
  } catch (err) {
    console.warn("Invalid or expired token", err);
  }
}
let { data: students, error: studentsError } = await Astro.callAction(actions.professor.getSubjectsStudents, { token: token as string, subject_id: String(subject?.id) });
if (students === null || studentsError != undefined) {
  students = [];
}
let { data: practices, error: practicesError } = await Astro.callAction(actions.user.getPractices, { token: token as string, subject_id: String(subject?.id) });
if (practices === null || practicesError != undefined) {
  practices = [];
}
practices = await Promise.all(practices.map(async (practice: any) => {
  const { data: groups, error:groupsError } = await Astro.callAction(actions.user.getGroups, { token: token as string, subject_id: String(subject?.id), practice_id: String(practice.id) });
  if(groups && Array.isArray(groups)) {
    return {
      ...practice,
      groups: groups
    };
  }
  return {
    ...practice,
    groups: []
  };
}));
---
<div>
  <section class="subject-info">
    <h1>{subject?.name}</h1>
    <div>
      <p>Curso: {subject?.course}</p>
      <p>Titulación: {subject?.degree}</p>
    </div>
  </section>
  <section class="actions">
    <a href={`/asignaturas/${subject?.id}/practicas/crear`}>
      <button>Crear Prácticas</button>
    </a>
    <a href={`/asignaturas/${subject?.id}/grupos/create`}>
      <button>Crear Grupos</button>
    </a>
    <button id={`downloadSubjectGrades${subject?.id}`} data-download-subject-grades-btn data-token={token} data-subject_id={subject.id}>Descargar Notas</button>
  </section>
  <section class="practice">
    <h1>Prácticas</h1>
    <table>
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Descripción</th>
          <th>Fecha de entrega</th>
          <th>Grupos</th>
          <th>Entregas</th>
        </tr>
      </thead>
      <tbody>
        {practices.map((practice: any) => (
          <tr>
            <td>{practice.name}</td>
            <td>{practice.description}</td>
            <td>{new Date(practice.deadline).toLocaleDateString('es-ES', { year: 'numeric', month: '2-digit', day: '2-digit' })}</td>
            <td><div class="groups-table">{practice.groups.map((group: any) => <a href={`/asignaturas/${subject?.id}/grupos/${group.id}`}>{group.name}</a>)}</div></td>
            <td><a href={`/asignaturas/${subject?.id}/practicas/${practice.id}/entregas`}><button>Ver</button></a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
  <section class="students">
    <h1>Alumnos</h1>
    <table>
      <thead>
        <tr>
          <th>Nombre de Usuario (DNI)</th>
          <th>Nombre</th>
          <th>Apellidos</th>
          <th>Grupo</th>
        </tr>
      </thead>
      <tbody>
        {students.map((student: any) => (
          <tr>
            <td>{student.username}</td>
            <td>{student.name}</td>
            <td>{student.surname}</td>
            <td>
              <div class="groups-table">
                {
                  student.groups.map((group_id: any) => practices.find((practice: any) => practice.groups.find((group: any) => group.id === group_id)) !== undefined ? 
                  <a href={`/asignaturas/${subject?.id}/grupos/${group_id}`}>
                    {practices.find((practice: any) => practice.groups.find((group: any) => group.id === group_id))?.groups.find((group: any) => group.id === group_id)?.name}-{practices.find((practice: any) => practice.groups.find((group: any) => group.id === group_id))?.name}
                  </a> : null)
                }
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</div>

<script>
import { actions } from "astro:actions";
import { showToast, TOASTSTYLE } from "@/utils/toaster";
const downloadSubjectGradesBtns = document.querySelectorAll('[data-download-subject-grades-btn]');
downloadSubjectGradesBtns?.forEach((downloadGradesBtn) => {
    downloadGradesBtn?.addEventListener('click', async () => {
      const token = downloadGradesBtn?.dataset.token;
      const subject_id = downloadGradesBtn?.dataset.subject_id;
      const { data: response, error:  responseError } = await actions.professor.downloadSubjectGrades({ token: token as string, subject_id: String(subject_id)})
      if(responseError) showToast(responseError.message, TOASTSTYLE.error)
      if(response) {
        // 1. Convertimos el string de texto plano a un objeto binario (Blob) indicando que es un CSV
        const blob = new Blob([response as string], { type: 'text/csv;charset=utf-8;' });
        // 2. Creamos el enlace temporal para forzar la descarga en el navegador
        const url = window.URL.createObjectURL(blob);
        const downloadAnchor = document.createElement('a');
        downloadAnchor.href = url;
        downloadAnchor.download = `asignatura_${subject_id}_notas.csv`;
        document.body.appendChild(downloadAnchor);
        downloadAnchor.click();
        // 3. Limpieza
        document.body.removeChild(downloadAnchor);
        window.URL.revokeObjectURL(url);
        showToast('Descarga procesada', TOASTSTYLE.success);
      }
    })
  })
</script>

<style>
  a {
    text-decoration: none;
    color: inherit;
  }
div {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    gap: 1rem;
}
.subject-info {
  display: flex;
  flex-direction: column;
  width: 100%;
  align-items: center;
}
.subject-info div {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  place-content: center;
  gap: 1rem;
}
.groups-table {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 0.5rem;
}
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}
</style>