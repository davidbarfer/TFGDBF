---
import { getPractices,getGroups } from "@/utils/users";
import { getSubjectsStudents } from "@/utils/professor";
import jwt from 'jsonwebtoken'
const secret = import.meta.env.JWT_SECRET;
const { subject, token } = Astro.props;
let user = null;
if (token) {
  try {
    user = jwt.verify(token, secret); // same secret as backend
  } catch (err) {
    console.warn("Invalid or expired token", err);
  }
}
let students = await getSubjectsStudents(token as string, subject?.id as string);
if (students === null) {
  students = [];
}
let practices = await getPractices(token as string, subject?.id as string);
if (practices === null) {
  practices = [];
}
// Replace the forEach with Promise.all and map
practices = await Promise.all(practices.map(async (practice: any) => {
  const groups = await getGroups(token as string, subject?.id as string, practice.id as string);
  if(groups && Array.isArray(groups)) {
    return {
      ...practice,
      groups: groups
    };
  }
  return {
    ...practice,
    groups: []
  };
}));
---
  <div>
    <section class="subject-info">
      <h1>{subject?.name}</h1>
      <div>
        <p>Curso: {subject?.course}</p>
        <p>Titulación: {subject?.degree}</p>
      </div>
    </section>
    <section class="actions">
      <a href={`/asignaturas/${subject?.id}/create`}>
        <button>Crear prácticas</button>
      </a>
      <a href={`/asignaturas/${subject?.id}/grupos/create`}>
        <button>Crear grupos</button>
      </a>
    </section>
    <section class="practice">
      <h1>Prácticas</h1>
      <table>
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Fecha de entrega</th>
            <th>Grupos</th>
            <th>Entregas</th>
          </tr>
        </thead>
        <tbody>
          {practices.map((practice: any) => (
            <tr>
              <td>{practice.name}</td>
              <td>{practice.description}</td>
              <td>{practice.deadline}</td>
              <td><div class="groups-table">{practice.groups.map((group: any) => <a href={`/asignaturas/${subject?.id}/grupos/${group.id}`}>{group.name}</a>)}</div></td>
              <td>Ver Entregas (TODO)</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
    <section class="students">
      <h1>Alumnos</h1>
      <table>
        <thead>
          <tr>
            <th>Nombre de Usuario (DNI)</th>
            <th>Nombre</th>
            <th>Apellidos</th>
            <th>Grupo</th>
          </tr>
        </thead>
        <tbody>
          {students.map((student: any) => (
            <tr>
              <td>{student.username}</td>
              <td>{student.name}</td>
              <td>{student.surname}</td>
              <td><div class="groups-table">{student.groups.map((group_id: any) => <a href={`/asignaturas/${subject?.id}/grupos/${group_id}`}>{group_id}</a>)}</div></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </div>
<style>
  a {
    text-decoration: none;
    color: inherit;
  }
div {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    gap: 1rem;
}
.subject-info {
  display: flex;
  flex-direction: column;
  width: 100%;
  align-items: center;
}
.subject-info div {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  place-content: center;
  gap: 1rem;
}
.groups-table {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 0.5rem;
}
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}
</style>