---
import { getPractices } from "@/utils/public";
import jwt from 'jsonwebtoken'
const secret = import.meta.env.JWT_SECRET;
const { subject, token } = Astro.props;
let user = null;
if (token) {
  try {
    user = jwt.verify(token, secret); // same secret as backend
  } catch (err) {
    console.warn("Invalid or expired token", err);
  }
}
let practices = await getPractices(token as string, subject?.id as string);
if (practices === null) {
  practices = [];
}
---
  <div>
    <section class="subject-info">
      <h1>{subject?.name}</h1>
      <div>
        <p>Curso: {subject?.course}</p>
        <p>Titulación: {subject?.degree}</p>
      </div>
    </section>
    <section class="actions">
      <a href="#"><button>Apuntarme a un Grupo</button></a>
    </section>
    <section class="practice">
      <h1>Prácticas</h1>
      <table>
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Fecha de entrega</th>
            <th>Grupo</th>
            <th>Entrega</th>
          </tr>
        </thead>
        <tbody>
          {practices.map((practice: any) => (
            <tr>
              <td>{practice.name}</td>
              <td>{practice.description}</td>
              <td>{practice.deadline}</td>
              <td>Ver Grupo (TODO)</td>
              <td>Ver Entrega (TODO)</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </div>
<style>
  a {
    text-decoration: none;
    color: inherit;
  }
div {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    gap: 1rem;
}
.subject-info {
  display: flex;
  flex-direction: column;
  width: 100%;
  align-items: center;
}
.subject-info div {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  place-content: center;
  gap: 1rem;
}
.groups-table {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 0.5rem;
}
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}
</style>