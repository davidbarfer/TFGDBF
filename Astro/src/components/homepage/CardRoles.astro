---
interface Props {
  userRole?: string | null;
  roleFunction: Array<string>;
}
const { userRole, roleFunction } = Astro.props;
---

<article class="roles-card">
  <h1 class="roles-title">
    {userRole ? `Funcionalidades de tu usuario como ${userRole}` : "Funcionalidades de la aplicación"}
  </h1>
  <ul class="functions-list">
  {roleFunction?.map((elementList : string) => (
    <li class="function-item"> 
     <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg> 
     <span>{elementList}</span>
    </li>
  ))}
  </ul>
</article>

<style>
  ul, li {
    list-style: none;
  }
  .roles-card {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    padding: 2.5rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    width: 100%;
    box-sizing: border-box;
  }

  .roles-title {
    font-size: 1.75rem;
    margin: 0 0 1.5rem 0;
    color: #111;
    text-transform: capitalize; /* Convierte el rol a mayúscula inicial */
  }

  /* Estilos para la Lista */
  .functions-list {
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem; /* Espaciado uniforme entre funciones */
  }

  .function-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.05rem;
    color: #444;
    line-height: 1.4;
    padding: 0.5rem 0;
  }

  /* Icono de check personalizado */
  .check-icon {
    color: var(--color-sucess); /* Verde éxito */
    flex-shrink: 0; /* Evita que el icono se deforme si el texto es largo */
  }
</style>