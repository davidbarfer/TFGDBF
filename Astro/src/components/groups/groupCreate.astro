---
import { getPractices } from "@/utils/public";
const { id, token, subject } = Astro.props;
const practices = await getPractices(token as string, id as string);
---
<section>
  <h1>Crear grupo</h1>
  <h2>Asignatura: {subject?.name}</h2>
  <form id="groupForm" data-id={id} data-token={token}>
    <label for="practice">Selecciona la práctica</label>
    <select name="practice_id" id="practice">
      <option value="">Selecciona una práctica</option>
      {practices.map((practice: any) => (
        <option value={practice.id}>{practice.name}</option>
      ))}
    </select>
    <label for="groupsNumber">Numero de grupos</label>
    <input type="number" id="groupsNumber" name="groupsNumber" required>
    <section id="groups"></section>
    <button type="submit">Crear</button>
  </form>
</section>

<script>
import { createGroups } from "@/utils/professor";
const groupsNumber = document.getElementById('groupsNumber');

function renderGroups(count: number) {
  const groups = document.getElementById('groups');
  if (groups) {
    groups.innerHTML = '';
  }
  for (let i = 0; i < count; i++) {
    const group = document.createElement('div');
    group.className = 'group-container';
    group.innerHTML = `
      <label for="group_name_${i}">Grupo: </label>
      <input type="text" id="group_name_${i}" name="group_name_${i}" value="${i + 1}" readonly required style="background-color: var(--color-primary);">
      <label for="max_participants_${i}">Máximo de participantes</label>
      <input type="number" id="max_participants_${i}" name="max_participants_${i}" min="1" required>
      <label for="group_date_${i}">Fecha del grupo</label>
      <input type="date" id="group_date_${i}" name="group_date_${i}" required>
      <label for="start_time_${i}">Hora de inicio</label>
      <input type="time" id="start_time_${i}" name="start_time_${i}" required>
      <label for="end_time_${i}">Hora de fin</label>
      <input type="time" id="end_time_${i}" name="end_time_${i}" required>
    `;
    document.getElementById('groups')?.appendChild(group);
  }
}
groupsNumber?.addEventListener('input', (e) => {
  renderGroups(Number(e?.target?.value));
  const form = document.getElementById('groupForm');
  if (form) {
    const subject_id = form.dataset.id;
    const token = form.dataset.token;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const practice_id = formData.get('practice_id');
      const groupsNumber = formData.get('groupsNumber');
      
      if (!practice_id || !groupsNumber) {
        alert('Por favor, completa todos los campos obligatorios');
        return;
      }

      try {
        // Create an array to store all group creation promises
        const groupPromises = [];
        
        // Loop through each group and create it
        for (let i = 0; i < Number(groupsNumber); i++) {
          const groupData = {
            practice_id: practice_id.toString(),
            group_name: formData.get(`group_name_${i}`)?.toString() || `${i + 1}`,
            max_participants: Number(formData.get(`max_participants_${i}`)),
            group_date: formData.get(`group_date_${i}`)?.toString() || '',
            start_time: formData.get(`start_time_${i}`)?.toString() || '',
            end_time: formData.get(`end_time_${i}`)?.toString() || ''
          };
          groupPromises.push(createGroups(token, subject_id, groupData));
        }
        
        // Wait for all groups to be created
        await Promise.all(groupPromises);
        alert('Grupos creados exitosamente');
      } catch (error) {
        console.error('Error creating groups:', error);
        alert('Error al crear los grupos. Por favor, inténtalo de nuevo.');
      }
    });
  } 
});
renderGroups(Number(groupsNumber?.value));
</script>

<style>
  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
#groups {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>