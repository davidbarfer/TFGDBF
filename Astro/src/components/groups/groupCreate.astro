---
import { actions } from "astro:actions";
const { id, token, subject } = Astro.props;
const { data: practices, error } = await Astro.callAction(actions.user.getPractices, { token: token as string, subject_id: id as string });
---
<section>
  <h1>Crear grupo</h1>
  <h2>Asignatura: {subject?.name}</h2>
  <form id="groupForm" data-id={id} data-token={token}>
    <label for="practice">Selecciona la práctica</label>
    <select name="practice_id" id="practice">
      <option value="">Selecciona una práctica</option>
      {practices?.map((practice: any) => (
        <option value={practice.id}>{practice.name}</option>
      ))}
    </select>
    <section id="numberGroups">
    <label for="groupsNumber">Número de grupos</label>
      <input type="number" id="groupsNumber" name="groupsNumber" required>
      <p>Cambiar el número de grupos borrara todos los datos introduccidos</p>
    </section>
    <section id="groups"></section>
    <button type="submit">Crear</button>
  </form>
</section>

<script>
import { actions } from "astro:actions";
import { showToast, showToastOnLoad, TOASTSTYLE } from "@/utils/toaster";

const groupsNumber = document.getElementById('groupsNumber') as HTMLInputElement | null;
const form = document.getElementById('groupForm') as HTMLFormElement | null;

function renderGroups(count: number) {
  const groups = document.getElementById('groups');
  if (groups) {
    groups.innerHTML = '';
  }
  for (let i = 0; i < count; i++) {
    const group = document.createElement('div');
    group.className = 'group-container';
    group.innerHTML = `
      <label for="group_name_${i}">Grupo: </label>
      <input type="text" id="group_name_${i}" name="group_name_${i}" value="${i + 1}" readonly required style="background-color: var(--color-primary);">
      <label for="max_participants_${i}">Máximo de participantes</label>
      <input type="number" id="max_participants_${i}" name="max_participants_${i}" min="1" required>
      <label for="group_date_${i}">Fecha del grupo</label>
      <input type="date" id="group_date_${i}" name="group_date_${i}" required>
      <label for="start_time_${i}">Hora de inicio</label>
      <input type="time" id="start_time_${i}" name="start_time_${i}" required>
      <label for="end_time_${i}">Hora de fin</label>
      <input type="time" id="end_time_${i}" name="end_time_${i}" required>
    `;
    document.getElementById('groups')?.appendChild(group);
  }
}

groupsNumber?.addEventListener('input', (e) => {
  const target = e.target as HTMLInputElement;
  renderGroups(Number(target.value));
});

if (form) {
  const subject_id = form.dataset.id;
  const token = form.dataset.token;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const targetForm = e.target as HTMLFormElement;
    const formData = new FormData(targetForm);
    const practice_id = formData.get('practice_id');
    const groupsNumberVal = formData.get('groupsNumber');
    
    if (!practice_id || !groupsNumberVal) {
      showToast('Por favor, completa todos los campos obligatorios', TOASTSTYLE.error);
      return;
    }

    try {
      const groupsPayload = [];
      
      for (let i = 0; i < Number(groupsNumberVal); i++) {
        groupsPayload.push({
          group_name: formData.get(`group_name_${i}`)?.toString() || `${i + 1}`,
          max_participants: Number(formData.get(`max_participants_${i}`)),
          group_date: formData.get(`group_date_${i}`)?.toString() || '',
          start_time: formData.get(`start_time_${i}`)?.toString() || '',
          end_time: formData.get(`end_time_${i}`)?.toString() || ''
        });
      }

      // ENVÍO ÚNICO: Mandamos todo el paquete en una sola petición HTTP
      const { data , error } = await actions.professor.createGroups({
        token: token as string,
        practice_id: practice_id as string,
        groups: groupsPayload 
      });
      
      if (error) {
        showToast(error.message || 'Error al intentar generar el lote de grupos', TOASTSTYLE.error);
      } else {
        showToastOnLoad('Todos los grupos fueron creados exitosamente en bloque', TOASTSTYLE.success);
        window.location.href = `/asignaturas/${subject_id}`;
      }

    } catch (error: any) {
      showToast(`Error inesperado al procesar la solicitud:\n${error.message || error}`, TOASTSTYLE.error);
    }
  });
}

renderGroups(Number(groupsNumber?.value || 0));
</script>

<style>
  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  #groups {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  #numberGroups {
    display: flex;
    flex-direction: row;
    gap: 1rem;
    align-items: center;
  }
  #numberGroups p {
    font-style: italic;
    font-weight: bold;
    color: var(--color-error)
  }
</style>