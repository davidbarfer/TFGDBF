---
import jwt from "jsonwebtoken";
import { actions } from "astro:actions";
import Modal from "@/components/utils/Modal.astro";
const secret = import.meta.env.JWT_SECRET;
const { group, practice, token } = Astro.props;
let user = null;
if (token) {
  try {
    user = jwt.verify(token, secret); // same secret as backend
  } catch (err) {
    console.warn("Invalid or expired token", err);
  }
}
const { data: students, error: studentsError } = await Astro.callAction(
  actions.user.getGroupStudents,
  { token: token as string, group_id: String(group?.id) }
);
---

<div>
  <h1>Grupo {group?.name} - {practice?.name}</h1>
  <h3>Descripción: {group?.description ? group?.description : 'Este grupo no tiene descripción' }</h3>
  <section class="group-info">
    <p>
      Participantes: {group?.current_participants} / {group?.max_participants}
    </p>
    <p>
      Fecha: {
        new Date(group?.practice_group_date).toLocaleDateString("es-ES", {
          year: "numeric",
          month: "2-digit",
          day: "2-digit",
        })
      }
    </p>
    <p>Hora de inicio: {group?.start_time}</p>
    <p>Hora de fin: {group?.end_time}</p>
  </section>
  <section class="group-actions">
    <a href={`/asignaturas/${practice?.subject_id}/grupos/${group?.id}/edit`}
      ><button>Editar</button></a
    >
    <button
      id="deleteGroupBtn"
      data-id={group?.id}
      data-token={token}
      data-subject_id={practice?.subject_id}>Eliminar</button
    >
    <Modal id="createSubmissionsGroupModal" btnText="Crear Entregas">
      <main slot="mainModal">
        <h1>Crear Entregas</h1>
        <h2>Práctica {practice.name}</h2>
        <p>Va a crear una entrega por cada alumno de este grupo</p>
        <p>La fecha de entrega será la fecha del grupo + 7 días naturales</p>
        <button
          id="createSubmissionsGroupBtn"
          data-id={group?.id}
          data-token={token}
          data-practice_id={practice?.id}
        >
          Aceptar
        </button>
      </main>
      <button slot="closeModal">Cancelar</button>
    </Modal>
    <button id="downloadGroupStudents" data-token={token} data-group_id={group?.id}>Descargar Lista Alumnos</button>
  </section>
  <section>
    <h2>Alumnos</h2>
    <table>
      <thead>
        <tr>
          <th>Nombre de Usuario (DNI)</th>
          <th>Nombre</th>
          <th>Apellido</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        {
          students.map((student: any) => (
            <tr>
              <td>{student.username}</td>
              <td>{student.name}</td>
              <td>{student.surname}</td>
              <td>
                <button
                  id="deleteStudentBtn"
                  data-group_id={group?.id}
                  data-student_id={student.id}
                  data-token={token}
                >
                  Eliminar
                </button>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>
</div>

<style>
  a {
    text-decoration: none;
    color: inherit;
  }
  .group-info,
  .group-actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: 1rem;
  }
</style>
<script>
  import { actions } from "astro:actions";
  import { showToast, showToastOnLoad, TOASTSTYLE } from "@/utils/toaster";
  const deleteGroupBtn = document.getElementById("deleteGroupBtn");
  const createSubmissionsGroupBtn = document.getElementById(
    "createSubmissionsGroupBtn"
  );
  const deleteStudentBtn = document.getElementById("deleteStudentBtn");
  const downloadGroupStudentsBtn = document.getElementById("downloadGroupStudents");
  deleteGroupBtn?.addEventListener("click", async () => {
    const id = deleteGroupBtn?.dataset.id;
    const token = deleteGroupBtn?.dataset.token;
    const { data: response, error: responseError } =
      await actions.professor.deleteGroup({
        token: token as string,
        group_id: String(id),
      });
    if (responseError) {
      showToast(responseError.message, TOASTSTYLE.error);
    } else {
      showToastOnLoad("Grupo eliminado",TOASTSTYLE.success);
      const subject_id = deleteGroupBtn?.dataset.subject_id;
      window.location.href = `/asignaturas/${subject_id}`;
    }
  });
  deleteStudentBtn?.addEventListener("click", async () => {
    const group_id = deleteStudentBtn?.dataset.group_id;
    const student_id = deleteStudentBtn?.dataset.student_id;
    const token = deleteStudentBtn?.dataset.token;
    const { data: response, error: responseError } =
      await actions.professor.deleteStudentGroup({
        token: token as string,
        group_id: String(group_id),
        student_id: String(student_id),
      });
    if (responseError) {
      showToast(responseError.message, TOASTSTYLE.error);
    } else {
      showToastOnLoad("Alumno eliminado", TOASTSTYLE.success);
      window.location.reload();
    }
  });
  createSubmissionsGroupBtn?.addEventListener("click", async () => {
    const group_id = createSubmissionsGroupBtn?.dataset.id;
    const practice_id = createSubmissionsGroupBtn?.dataset.practice_id;
    const token = createSubmissionsGroupBtn?.dataset.token;
    const { data: response, error: responseError } =
      await actions.professor.createSubmissionsGroup({
        token: token as string,
        url_data: {
          group_id: String(group_id),
          practice_id: String(practice_id),
        },
      });
    if (responseError) {
      const modal = document.getElementById('createSubmissionsGroupModal') as HTMLDialogElement;
      modal?.close()
      showToast(responseError.message, TOASTSTYLE.error);
    } else {
      showToastOnLoad("Entregas creadas", TOASTSTYLE.success);
      window.location.reload();
    }
  });
  downloadGroupStudentsBtn?.addEventListener("click", async () => {
    const token = downloadGroupStudentsBtn?.dataset.token;
    const group_id = downloadGroupStudentsBtn?.dataset.group_id;
    const { data: response, error:  responseError } = await actions.professor.downloadGroupStudents({ token: token as string, group_id: String(group_id)})
    if(responseError) showToast(responseError.message, TOASTSTYLE.error)
    if(response) {
      // 1. Convertimos el string de texto plano a un objeto binario (Blob) indicando que es un CSV
      const blob = new Blob([response as string], { type: 'text/csv;charset=utf-8;' });
      // 2. Creamos el enlace temporal para forzar la descarga en el navegador
      const url = window.URL.createObjectURL(blob);
      const downloadAnchor = document.createElement('a');
      downloadAnchor.href = url;
      downloadAnchor.download = `grupo_${group_id}_alumnos.csv`;
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      // 3. Limpieza
      document.body.removeChild(downloadAnchor);
      window.URL.revokeObjectURL(url);
      showToast('Descarga procesada', TOASTSTYLE.success);
    }
  });
</script>
