---
import jwt from 'jsonwebtoken'
import { getGroupStudents } from '@/utils/users';
const secret = import.meta.env.JWT_SECRET;
const { group, token } = Astro.props;
let user = null;
if (token) {
  try {
    user = jwt.verify(token, secret); // same secret as backend
  } catch (err) {
    console.warn("Invalid or expired token", err);
  }
}
const students = await getGroupStudents(token, group?.id as string);
---

<div>
  <h1>Grupo {group?.name}</h1>
  <section class="group-info">
    <p>Participantes: {group?.current_participants} / {group?.max_participants}</p>
    <p>Fecha: {group?.practice_group_date}</p>
    <p>Hora de inicio: {group?.start_time}</p>
    <p>Hora de fin: {group?.end_time}</p>
  </section>
  <section>
    <h2>Alumnos</h2>
    <table>
      <thead>
        <tr>
          <th>Nombre de Usuario (DNI)</th>
          <th>Nombre</th>
          <th>Apellido</th>
        </tr>
      </thead>
      <tbody>
        {students.map((student: any) => (
          <tr>
            <td>{student.username}</td>
            <td>{student.name}</td>
            <td>{student.surname}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</div>

<style>
  .group-info, .group-actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: 1rem;
  }
</style>