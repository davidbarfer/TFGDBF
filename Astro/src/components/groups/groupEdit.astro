---
import { setISODateYYYYMMDD } from "@/utils/dates";
const { group, token} = Astro.props;
---
<section> 
  <h1>Editar grupo {group?.name}</h1>
  <form id="groupForm" data-id={group?.id} data-token={token}>
    <label for="group_name">Nombre del grupo</label>
    <input type="text" id="group_name" name="group_name" value={group?.name} required readonly>
    <label for="max_participants">Máximo de participantes</label>
    <input type="number" id="max_participants" name="max_participants" value={group?.max_participants} required>
    <label for="group_date">Fecha del grupo</label>
    <input type="date" id="group_date" name="group_date" value={setISODateYYYYMMDD(group?.practice_group_date)} required>
    <label for="start_time">Hora de inicio</label>
    <input type="time" id="start_time" name="start_time" value={group?.start_time} required>
    <label for="end_time">Hora de fin</label>
    <input type="time" id="end_time" name="end_time" value={group?.end_time} required>
    <button type="submit">Actualizar</button>
  </form>
</section>

<script>
const form = document.getElementById('groupForm');
if (form) {
  const group_id = form?.dataset.id;
  const token = form?.dataset.token;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());
    // updateGroup(token, group_id, data);
  });
}
</script>

<style>
  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
#groups {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>