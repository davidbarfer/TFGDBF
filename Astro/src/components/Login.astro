<form id="loginForm">
  <label for="name">Nombre de Usuario (DNI)</label>
  <input type="text" name="username" required />
  <label for="password">Contraseña</label>
  <section class="passwordSection">
    <input type="password" name="password" id="password" required minlength="8" />
    <button type="button" id="togglePassword">Mostrar</button>
  </section>
  <button type="submit">Iniciar Sesión</button>
</form>


<script>
  import { login } from "@/utils/auth.ts";
  const loginForm = document.getElementById("loginForm");
  const toggleBtn = document.getElementById('togglePassword');
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  loginForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());
    login(data);
  });
  toggleBtn?.addEventListener('click', () => {
    const isPassword = passwordInput.getAttribute('type') === 'password';
    passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
    toggleBtn.textContent = isPassword ? 'Ocultar' : 'Mostrar';
  });
</script>

<style>
  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 360px;
  }
  input {
    width: 100%;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    color: var(--color-tertiary);
    background-color: white;
    border: 2px solid #e2e8f0;
    border-radius: 0.375rem;
    transition: all 0.2s ease;
  }
  
  input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(255, 158, 24, 0.2);
  }
  .passwordSection {
    display: flex;
    flex-direction: row;
    gap: 1rem;
  }
</style>
