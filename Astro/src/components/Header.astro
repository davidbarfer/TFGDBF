---
const { user } = Astro.props;
---
<header>
	<h1>DoctusLite</h1>
	{user ? (
		<p>User logged in</p>
	) : (
		<p>Not logged in</p>
	)}
</header>

<style>
	header {
		width: 100%;
    height: fit-content;
		background-color: var(--color-primary);
		color: var(--color-tertiary);
		padding: 1rem;
		text-align: center;
	}
</style>