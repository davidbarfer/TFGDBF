---
// No props required, but you could add size/color if you want
// const { size = 40, color = "#3b82f6" } = Astro.props;
---

<div class="spinner" role="status" aria-live="polite" aria-label="Loading">
  <span class="sr-only">Loading…</span>
</div>

<style>
  .spinner {
    width: 40px;
    height: 40px;
    margin: 4px;
    border-radius: 50%;
    border: 4px solid var(--color-border);       /* light gray track */
    border-top-color: var(--color-tertiary);        /* blue segment */
    animation: spinner-rotate 0.75s linear infinite;
  }

  @keyframes spinner-rotate {
    to {
      transform: rotate(360deg);
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
