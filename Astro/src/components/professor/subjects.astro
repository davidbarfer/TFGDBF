---
import Error from "@/components/Error.astro";
import { getSubjects } from "@/utils/professor.ts";
const { token } = Astro.props;
let subjects = [];
let error = '';
try {
  subjects = await getSubjects(token);
}
catch (err : any) {
  error = err.message;
}
---
{error ? (<Error error={error} />) : (
<section>
  <table>
    <thead>
      <tr>
        <th>Nombre</th>
        <th>Curso</th>
        <th>Grado</th>
      </tr>
    </thead>
    <tbody>
      {subjects.map(subject => (
        <tr>
          <td><a href={`/asignaturas/${subject.id}`}>{subject.name}</a></td>
          <td>{subject.course}</td>
          <td>{subject.degree}</td>
        </tr>
      ))}
    </tbody>
  </table>
</section>
)}
<style>
  section {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    gap: 1rem;
  }
  table {
    width: fit-content;
    border-collapse: collapse;
    margin: 0 auto;
  }
  th, td {
    border: 1px solid #ddd;
    padding: 8px;
    text-align: left;
  }
</style>