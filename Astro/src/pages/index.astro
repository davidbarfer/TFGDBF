---
import Layout from "@/layouts/Layout.astro";
import CardProject from "@/components/homepage/CardProject.astro";
import { PROJECT_NAME, PROJECT_AUTHOR, PROJECT_FRAMEWORKS, PROJECT_DESCRIPTION } from "@/consts/info";
import jwt from "jsonwebtoken";
import { parse } from "cookie";
import { roles } from "@/consts/users";

const cookies = parse(Astro.request.headers.get("cookie") || "");
const token = cookies.token;
const secret = import.meta.env.JWT_SECRET;
let user = null;
if (token) {
  try {
    user = jwt.verify(token, secret);
  } catch (err) {
    console.warn("Invalid or expired token", err);
  }
}
---

<Layout>
  <main class="container">
    <header class="auth-status">
      { user?.role === roles.admin || user?.role === roles.professor || user?.role === roles.student ? (
          <p class="logged-in">
            Sesión iniciada como: <span class="role-badge">{user.role}</span>
          </p>
        ) : (
          <p class="logged-out">No tienes sesión iniciada</p>
        )
      }
    </header>
    <CardProject 
      projectName={PROJECT_NAME}
      projectAuthor={PROJECT_AUTHOR}
      projectDescription={PROJECT_DESCRIPTION}
      frameworks={PROJECT_FRAMEWORKS}
    />
  </main>
</Layout>

<style>
  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
    font-family: system-ui, -apple-system, sans-serif;
    color: #333;
  }
  .auth-status {
    width: 100%;
    margin-bottom: 2rem;
    text-align: right;
    font-size: 0.9rem;
  }
  .logged-in {
    color: var(--color-sucess);
    font-weight: 500;
  }
  .role-badge {
    background-color: var(--color-primary);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    text-transform: uppercase;
    font-size: 0.8rem;
    font-weight: bold;
  }
  .logged-out {
    color: var(--color-error);
    font-style: italic;
  }
</style>