---
import Layout from "@/layouts/Layout.astro";
import { PROJECT_NAME, PROJECT_AUTHOR, PROJECT_FRAMEWORKS  } from "@/consts/info";
import jwt from "jsonwebtoken";
import { parse } from "cookie";
import { roles } from "@/consts/users";

const cookies = parse(Astro.request.headers.get("cookie") || "");
const token = cookies.token;
const secret = import.meta.env.JWT_SECRET;
let user = null;
if (token) {
  try {
    user = jwt.verify(token, secret); // same secret as backend
  } catch (err) {
    console.warn("Invalid or expired token", err);
  }
}
---

<Layout>
  <main>
    <section>
      { user?.role === roles.admin ? (
          <p>Has iniciado sesión como {user?.role}</p>
        ) : user?.role === roles.professor ? (
          <p>Has iniciado sesión como {user?.role}</p>
        ) : user?.role === roles.student ? (
          <p>Has iniciado sesión como {user?.role}</p>
        ) : (
          <p>No tienes sesión iniciada</p>
        )
      }
    </section>
    <section>
      <h1>{PROJECT_NAME}</h1>
      <p>Autor del Trabajo de Fin de grado : <strong>{PROJECT_AUTHOR}</strong></p>
      <p>Este proyecto consiste en una aplicación de gestión de grupos de práctica cuyas entregas se evaluan a través de un evaluador diseñado en MATLAB</p>
      <h2>Frameworks utilizados</h2>
      <section class="frameworks">
        <p>Frontend: {PROJECT_FRAMEWORKS.FRONTEND}</p>
        <p>Backend: {PROJECT_FRAMEWORKS.BACKEND}</p>
        <p>Base de datos: {PROJECT_FRAMEWORKS.DATABASE}</p>
        <p>Sistema de archivos: {PROJECT_FRAMEWORKS.FILESYSTEM}</p>
      </section>
    </section>
  </main>
</Layout>

<style>
  main {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    height: 100%;
  }
  section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
  }
  .frameworks {
    display: flex;
    flex-direction: row;
    gap: 1rem;
  }
</style>