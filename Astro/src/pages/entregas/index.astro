---
import Layout from "@/layouts/Layout.astro";
import StudentSubmissions from "@/components/submissions/studentSubmissions.astro";
import ProfessorSubmissions from "@/components/submissions/professorSubmissions.astro";
import PracticeInfo from "@/components/submissions/practiceInfo.astro";
import PracticeActions from "@/components/submissions/practiceActions.astro";
import Error from "@/components/utils/Error.astro";
import { showToast, TOASTSTYLE } from "@/utils/toaster";
import { actions } from 'astro:actions';
import jwt from 'jsonwebtoken'
import { parse } from 'cookie';
import { roles } from "@/consts/users";

const cookies = parse(Astro.request.headers.get('cookie') || '');
const token = cookies.token;
const secret = import.meta.env.JWT_SECRET;
let user = null;
if (token) {
  try {
    user = jwt.verify(token, secret); // same secret as backend
  } catch (err) {
    console.warn("Invalid or expired token", err);
  }
}
let practices: object[] = [];
let error = null;
if (user?.role === roles.professor || user?.role === roles.admin) {
  const { data: subjects, error: subjectsError } = await Astro.callAction(actions.user.getSubjectsUser, { token: token as string });
  if(subjects) {
    practices = await Promise.all(
      subjects.map(async (subject : any) => {
        const { data: practicesSubject, error: practicesSubjectError } = await Astro.callAction(actions.user.getPractices, { token: token as string, subject_id: String(subject.id) });
        if(practicesSubjectError) showToast(practicesSubjectError.message, TOASTSTYLE.error)
        return {
          subjectId: subject.id,
          subjectName: subject.name,
          subjectDegree: subject.degree,
          list: practicesSubject || []
        }
    })
  )} else {error = subjectsError}
}
---

<Layout>
  <article>
    {error ? (<Error message={error.message} />) : (null)}
    
    {user?.role === roles.professor || user?.role === roles.admin ? (
      // Loop 1: Iterate through our subjects
      practices.map(async (subjectGroup : any) => {
        
        // Fetch all submissions for this specific group before rendering HTML
        const practicesWithSubmissions = await Promise.all(
          subjectGroup?.list.map(async (practice: any) => {
            const { data: submissions } = await Astro.callAction(actions.professor.getPracticeSubmissions, {
              token: token as string,
              practice_id: String(practice.id),
            });
            return { ...practice, submissions }; // Attach submissions to the original practice object
          })
        );

        return (
          <details 
            class="subject-dropdown" 
            id={`subject-${subjectGroup.subjectId}`} 
            open={Astro.request.headers.get('cookie')?.includes(`opened_subject_${subjectGroup.subjectId}=true`)}
            data-id={subjectGroup.subjectId}
          >
            <summary class="subject-title">{subjectGroup?.subjectName} - {subjectGroup?.subjectDegree}</summary>
            
            <div class="subject-content">
              {practicesWithSubmissions.length === 0 ? (
                <p>No hay prácticas para esta asignatura</p>
              ) : (
                // Loop 2: Synchronously render the components with the resolved data
                practicesWithSubmissions.map((practice) => (
                  <section class="practice-card">
                    <PracticeInfo token={token} practice={practice} />
                    <PracticeActions token={token} practice={practice} />
                    {practice.submissions?.status === 404 ? (
                      <p>No hay entregas para esta práctica</p>
                    ) : (
                      <ProfessorSubmissions token={token} submissions={practice.submissions} subjectId={practice.subject_id} />
                    )}
                  </section>
                ))
              )}
            </div>
          </details>
        );
      })
    ) : user?.role === roles.student ? (
      <StudentSubmissions userId={user.userId} token={token} />
    ) : (
      <>
        <p>No tienes permiso para ver esta página</p>
        <a href="/">Volver al inicio</a>
      </>
    )}
  </article>
</Layout>

<script>
  document.addEventListener('toggle', (event) => {
    const target = event.target as HTMLDetailsElement;

    // Filtramos para actuar únicamente sobre nuestros desplegables de asignaturas
    if (target && target.classList.contains('subject-dropdown')) {
      const subjectId = target.getAttribute('data-id');
      if (!subjectId) return;

      if (target.open) {
        // Al abrir, creamos la cookie de la asignatura y la marcamos como la última activa
        document.cookie = `opened_subject_${subjectId}=true; path=/; max-age=86400; SameSite=Lax`;
        localStorage.setItem('openSubject', subjectId);
      } else {
        // Al cerrar, destruimos su cookie caducándola en el pasado
        document.cookie = `opened_subject_${subjectId}=; path=/; expires=Thu, 01 Jan 1970 00:00:00 UTC; SameSite=Lax`;
      }
    }
  }, true); // El parámetro 'true' activa la fase de captura necesaria para el evento toggle
</script>

<style>
  section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: 1rem;
  }
  a {
    text-decoration: none;
    color: var(--color-tertiary);
    text-transform: uppercase;
    font-weight: bold;
    padding: 0.5rem;
    cursor: pointer;
  }
  details.subject-dropdown {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    margin-bottom: 1rem;
    background-color: #ffffff;
  }
  summary.subject-title {
    padding: 1rem;
    font-weight: bold;
    cursor: pointer;
    color: var(--color-tertiary);
    user-select: none;
  }
  .subject-content {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .practice-card {
    padding-bottom: 1.5rem;
    border-bottom: 1px dashed var(--color-border);
  }
  .practice-card:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
</style>
