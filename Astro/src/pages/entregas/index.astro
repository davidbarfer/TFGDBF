---
import Layout from "@/layouts/Layout.astro";
import jwt from 'jsonwebtoken'
import { parse } from 'cookie';
import { roles } from "@/consts/users";

const cookies = parse(Astro.request.headers.get('cookie') || '');
const token = cookies.token;
const secret = import.meta.env.JWT_SECRET;
let user = null;
if (token) {
  try {
    user = jwt.verify(token, secret); // same secret as backend
  } catch (err) {
    console.warn("Invalid or expired token", err);
  }
}
---

<Layout>
  <section>
    {user?.role === roles.student || user?.role === roles.admin ? (
      <p>TODO: Tabla con las entregas de cada práctica</p>
    ) : (
      <p>No tienes permiso para ver esta página</p>
      <a href="/">Volver al inicio</a>
    )}
  </section>
</Layout>

<style>
  section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: 1rem;
  }
  a {
    text-decoration: none;
    color: var(--color-tertiary);
    text-transform: uppercase;
    font-weight: bold;
    padding: 0.5rem;
    cursor: pointer;
  }
</style>
