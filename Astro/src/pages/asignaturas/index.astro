---
import Layout from "@/layouts/Layout.astro";
import Subjects from "@/components/subjects/subjects.astro";
import jwt from 'jsonwebtoken'
import { parse } from 'cookie';
import { roles } from "@/consts/users";

const cookies = parse(Astro.request.headers.get('cookie') || '');
const token = cookies.token;
const secret = import.meta.env.JWT_SECRET;
let user = null;
if (token) {
  try {
    user = jwt.verify(token, secret); // same secret as backend
  } catch (err) {
    console.warn("Invalid or expired token", err);
  }
}
const isAdmin = user?.role === roles.admin;
const isProfessor = user?.role === roles.professor;
const isStudent = user?.role === roles.student;
---

<Layout>
  <article>
    {(isAdmin || isProfessor) &&
      <section>
        <a href="/asignaturas/crear" class="btn-primary">Crear asignatura</a>
        <button disabled>Eliminar asignatura</button>
      </section>
    }
      {isAdmin || isProfessor || isStudent ? (
        <Subjects token={token as string} />
      ) : (
        <p>No tienes permiso para ver esta página</p>
        <a href="/">Volver al inicio</a>
      )}
  </article>
</Layout>

<style>
  article {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: 1rem;
  }
  section {
    display: flex;
    gap: 1rem;
  }
  a {
    text-decoration: none;
    color: var(--color-tertiary);
    text-transform: uppercase;
    font-weight: bold;
    padding: 0.5rem;
    cursor: pointer;
  }
</style>
