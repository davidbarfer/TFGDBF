---
import Layout from "@/layouts/Layout.astro";
import { getSubject } from "@/utils/public";
const { id } = Astro.params;
const subject = await getSubject(id);
if (subject === null) {
  return Astro.redirect('/404');
}
---
<Layout>
  <section>
    <h1>{subject?.name}</h1>
    <p>{subject?.course}</p>
    <p>{subject?.degree}</p>
  </section>
</Layout>