---
import Layout from "@/layouts/Layout.astro";
import { actions } from "astro:actions";
import SubjectProffesor from "@/components/subjects/subjectProffesor.astro";
import SubjectStudent from "@/components/subjects/subjectStudent.astro";
import { roles } from "@/consts/users";
import jwt from 'jsonwebtoken'
import { parse } from 'cookie';
const cookies = parse(Astro.request.headers.get('cookie') || '');
const token = cookies.token;
const secret = import.meta.env.JWT_SECRET;
let user = null;
if (token) {
  try {
    user = jwt.verify(token, secret); // same secret as backend
  } catch (err) {
    console.warn("Invalid or expired token", err);
  }
}
const { asignaturaId: id } = Astro.params;
const { data: subject, error } = await Astro.callAction(actions.user.getSubject, { id: id as string, token: token as string });

if (error) {
  return Astro.redirect('/404');
}
---
<Layout>
  <div>
    {user?.role === roles.professor || user?.role === roles.admin ? (
      <SubjectProffesor subject={subject} token={token} />
    ) : ( user?.role === roles.student ? (
      <SubjectStudent subject={subject} token={token} />
    ) : (
      <p>No tienes permiso para ver esta página</p>
      <a href="/">Volver al inicio</a>
    ))}
  </div>
</Layout>

<style>
  a {
    text-decoration: none;
    color: inherit;
  }
div {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    gap: 1rem;
}
.subject-info {
  display: flex;
  flex-direction: column;
  width: 100%;
  align-items: center;
}
.subject-info div {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  place-content: center;
  gap: 1rem;
}
.groups-table {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 0.5rem;
}
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}
</style>