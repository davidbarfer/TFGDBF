---
import { actions } from "astro:actions";
import Layout from "@/layouts/Layout.astro";
import Modal from "@/components/utils/Modal.astro";
import Spinner from "@/components/utils/Spinner.astro";
import jwt from 'jsonwebtoken'
import { parse } from 'cookie';
import { roles } from "@/consts/users";

const { entregaId: submissionId } = Astro.params;
const cookies = parse(Astro.request.headers.get('cookie') || '');
const token = cookies.token;
const secret = import.meta.env.JWT_SECRET;
let user = null;
if (token) {
  try {
    user = jwt.verify(token, secret);
  } catch (err) {
    console.warn("Invalid or expired token", err);
  }
}
const { data: submission, error: submissionError } = await Astro.callAction(actions.professor.getSubmission, { token: token as string, submission_id: String(submissionId) });
if(submission.file_url) {
  const { data: submissionFile, error: submissionFileError } = await Astro.callAction(actions.user.getSubmissionFile, { token: token as string, student_id: String(submission.user_id), submission_id: String(submissionId)});
  if (submissionFile) {
    submission.file_content = submissionFile;
  }
}
---

<Layout>
  {
    user?.role === roles.admin || user?.role === roles.professor ? (
      <section>
        <h1>Editar entrega {submission.id}</h1>
        <div id="evaluator-grade-section">
            <p>La nota del evaluador no puede ser editada manualmente</p>
            <Modal id={`evaluatorModal${submission.id}`} btnText="Ejecutar evaluador">
              <main slot="mainModal">
                <p>Está acción ejecutara el evaluador y si no hay ningun error generara una nota en Nota del evaluador</p>
                <p>Ejecuta el evaluador consume recursos del sistema, por favor tengalo en cuenta</p>
                <section>
                  <Spinner id={`evaluatorSpinner${submission.id}`}/>
                  <button 
                    id = {`evaluatorBtn${submission.id}`} 
                    data-evaluatorBtn
                    data-token={token} 
                    data-user_id={submission.user_id} 
                    data-submission_id={submission.id} 
                  >
                    Aceptar
                  </button>
                </section>
              </main>
              <button slot="closeModal">Cancelar</button>
            </Modal>
        </div>
        <form id="submissionForm" data-token={token} data-submissionid={submission.id} data-practiceid={submission.practice_id}>
          <label for="delivery_date">Fecha de entrega</label>
          <input 
            type="date" 
            id="delivery_date" 
            name="delivery_date" 
            value={submission.delivery_date ? new Date(submission.delivery_date).toISOString().split('T')[0] : ''} 
            required
          />
          <label for="evaluator_grade">Nota del evaluador</label>
          <input 
            type="number" 
            id="evaluator_grade" 
            name="evaluator_grade" 
            value={submission.evaluator_grade} 
            max="10"
            min="0" 
            step="0.1" 
            readonly
          />
          <label for="grade">Nota del alumno</label>
          <input 
            type="number" 
            id="grade" 
            name="grade" 
            value={submission.grade} 
            max="10" 
            min="0" 
            step="0.01"
          />
          <label for="feedback">Comentarios</label>
          <textarea 
            id="feedback" 
            name="feedback" 
            placeholder="Escribe tus comentarios aquí"
          >{submission.feedback}</textarea>
          <button type="submit">Editar</button>
        </form>
      <section>
        <h1>Entrega del alumno (Archivo)</h1>
        <textarea readonly class="SubmissionDetails">{submission.file_content}</textarea>
      </section>
      </section>
    ) : (
      <section>
        <p>No tienes permiso para ver esta página</p>
        <a href="/">Volver al inicio</a>
      </section>
    )
  }
</Layout>

<script>
  import { actions } from "astro:actions";
  import { showToastOnLoad, TOASTSTYLE } from "@/utils/toaster";
  const evaluatorBtns = document.querySelectorAll('[data-evaluatorBtn]')
  const submissionForm = document.getElementById('submissionForm');
  submissionForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const token = submissionForm?.dataset.token;
    const submission_id = submissionForm?.dataset.submissionid;
    const practice_id = submissionForm?.dataset.practiceid;
    const urlData = { practice_id: practice_id, submission_id: submission_id }
    const formData = new FormData(e.target);
    const data = {
      delivery_date: formData.get('delivery_date') as string,
      evaluator_grade: formData.get('evaluator_grade') as string,
      grade: formData.get('grade') as string,
      feedback: formData.get('feedback') as string,
    };
    if(data.evaluator_grade === "") data.evaluator_grade = null;
    if(data.grade === "") data.grade = null;
    const {data: response, error: responseError} = await actions.professor.editSubmissionStudent({ token: token as string, url_data: urlData, submissionData: data });
    if (responseError) {
      showToastOnLoad(responseError.message, TOASTSTYLE.error);
      window.location.reload();
    } else {
      showToastOnLoad('Entrega editada exitosamente', TOASTSTYLE.success);
      const urlParams = new URLSearchParams(window.location.search);
      let redirectTo = urlParams.get('redirect') || '/default-fallback-path';
      const lastOpenedSubjectId = localStorage.getItem('openSubject');        
      if (lastOpenedSubjectId) {
        redirectTo = `${redirectTo}#subject-${lastOpenedSubjectId}`;
      }
      window.location.assign(redirectTo);
    }
  });
  evaluatorBtns?.forEach(evaluatorBtn => evaluatorBtn.addEventListener('click', async() => {
    const submissionId = evaluatorBtn?.dataset.submission_id;
    const spinner = document.getElementById(`evaluatorSpinner${submissionId}`)
    evaluatorBtn?.classList.toggle('toggleSendBtn');
    spinner?.classList.toggle('toggleVisiblity');
    const token = evaluatorBtn?.dataset.token;
    const url_data = {
      user_id: evaluatorBtn?.dataset.user_id as string,
      submission_id: submissionId as string,
    }
    const { data, error } = await actions.professor.executeSubmssionEvaluator({
      token: token as string,
      url_data: url_data
    })
    try {
      if(error) {
        showToastOnLoad(error.message, TOASTSTYLE.error);
      } else {
        showToastOnLoad('Evaluador ejecutado', TOASTSTYLE.success);
      }
      const lastOpenedSubjectId = localStorage.getItem('openSubject');
      if (lastOpenedSubjectId) {
        window.location.href = `${window.location.pathname}#subject-${lastOpenedSubjectId}`;
        window.location.reload();
      } else {
        window.location.reload();
      }
    } finally {
      spinner?.classList.toggle('toggleVisiblity');
      evaluatorBtn?.classList.toggle('toggleSendBtn');
    }
  }))
</script>

<style scoped>
  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    textarea {
      field-sizing: content;
      min-height: 10rem;
      max-height: 20rem;
    }
  }
  #evaluator-grade-section {
    display: flex;
    flex-direction: row;
    gap: 1rem;
  }
  .SubmissionDetails { 
    min-height: 60px;
    border: 2px var(--color-border) solid;
    padding: 1rem;
    resize: none;
    outline: none;
  }
  .toggleSendBtn {
    display: none !important;
  }
</style>