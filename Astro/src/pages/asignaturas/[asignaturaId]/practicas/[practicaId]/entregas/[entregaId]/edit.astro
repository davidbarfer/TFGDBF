---
import { actions } from "astro:actions";
import Layout from "@/layouts/Layout.astro";
import jwt from 'jsonwebtoken'
import { parse } from 'cookie';
import { roles } from "@/consts/users";

const { entregaId: submissionId } = Astro.params;
const cookies = parse(Astro.request.headers.get('cookie') || '');
const token = cookies.token;
const secret = import.meta.env.JWT_SECRET;
let user = null;
if (token) {
  try {
    user = jwt.verify(token, secret); // same secret as backend
  } catch (err) {
    console.warn("Invalid or expired token", err);
  }
}
const { data: submission, error: submissionError } = await Astro.callAction(actions.professor.getSubmission, { token: token as string, submission_id: String(submissionId) });
---

<Layout>
  {(user?.role === roles.admin || user?.role === roles.professor) ? (
    <section>
    <h1>Editar entrega {submission.id}</h1>
    <form id="submission-form" data-token={token} data-submission={submission}>
      <label for="delivery_date">Fecha de entrega</label>
      <input type="date" id="delivery_date" name="delivery_date" required value={submission.delivery_date ? new Date(submission.delivery_date).toISOString().split('T')[0] : ''}>
      <label for="evaluator_grade">
        <p>Nota del evaluador</p>
        <div id="evaluator-grade-section">
          <p>La nota del evaluador no puede ser editada</p>
          <button type="button" disabled>Ejecutar evaluador</button>
        </div>
      </label>
      <input type="number" id="evaluator_grade" name="evaluator_grade" value={submission.evaluator_grade} max="10" min="0" step="0.1" disabled>
      <label for="grade">Nota del alumno</label>
      <input type="number" id="grade" name="grade" required value={submission.grade} max="10" min="0" step="0.1">
      <label for="feedback">Comentarios</label>
      <textarea id="feedback" name="feedback" required placeholder="Escribe tus comentarios aquí">{submission.feedback}</textarea>
      <button type="submit">Editar</button>
    </form>
    </section>
  ) : (
    <section>
      <p>No tienes permiso para ver esta página</p>
      <a href="/">Volver al inicio</a>
    </section>
  )}
</Layout>

<style>
  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    textarea {
      field-sizing: content;
      min-height: 10rem;
      max-height: 20rem;
    }
  }
  #evaluator-grade-section {
    display: flex;
    flex-direction: row;
    gap: 1rem;
  }
</style>