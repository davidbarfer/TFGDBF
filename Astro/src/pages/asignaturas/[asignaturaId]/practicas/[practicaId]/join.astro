---
import { actions } from "astro:actions";
import Layout from "@/layouts/Layout.astro";
import jwt from 'jsonwebtoken'
import { parse } from 'cookie';
const { practicaId:id } = Astro.params;
const cookies = parse(Astro.request.headers.get('cookie') || '');
const token = cookies.token;
const secret = import.meta.env.JWT_SECRET;
let user = null;
if (token) {
  try {
    user = jwt.verify(token, secret); // same secret as backend
  } catch (err) {
    console.warn("Invalid or expired token", err);
  }
}
let { data: practice, error: practiceError } = await Astro.callAction(actions.user.getPractice, { token: token as string, practice_id: id as string });
const { data: groups, error: groupsError } = await Astro.callAction(actions.user.getGroups, { token: token as string, subject_id: String(practice?.subject_id), practice_id: String(practice?.id) });
if(groups && Array.isArray(groups)) {
  practice = {
    ...practice,
    groups: groups
  };
}
const { data: userGroups, error: userGroupsError } = await Astro.callAction(actions.user.getStudentGroups, { token: token as string, user_id: String(user?.userId)});
// Create a Set of group ids for quick lookup
const groupIds = new Set(groups.map((g: any) => g.id));

// Find matching userGroup ids
const matchingIds = userGroups
  .map((ug: any) => ug.id)
  .filter((id: any) => groupIds.has(id));

// Result
const isEnrolled = matchingIds.length > 0;
---
<Layout>
<div>
    <section>
      <h1>Práctica {practice?.name}</h1>
      <div>
        <p>{practice?.description}</p>
        <p>Fecha de entrega: {new Date(practice?.deadline).toLocaleDateString('es-ES', { year: 'numeric', month: '2-digit', day: '2-digit' })}</p>
      </div>
    </section>
    <section>
      <table>
        <thead>
          <tr>
            <th>Grupo</th>
            <th>Fecha</th>
            <th>Horario</th>
            <th>Alumnos</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          {practice?.groups.map((group: any) => (
            <tr>
            <td>{group.name}</td>
            <td>{new Date(group.practice_group_date).toLocaleDateString('es-ES', { year: 'numeric', month: '2-digit', day: '2-digit' })}</td>
            <td>{group.start_time} - {group.end_time}</td>
            <td>{Number(group.current_participants)} / {Number(group.max_participants)}</td>
            <td>
              {isEnrolled ? (
                Number(group.id) === Number(matchingIds[0]) ? (
                  <button disabled>Inscrito Aquí</button>
                ) : (
                  <button disabled>Ya estás inscrito en otro grupo</button>
                )
              ) : Number(group.current_participants) < Number(group.max_participants) ? (
                <button class="joinGroupBtn" data-groupId={group.id} data-token={token} data-userId={user?.userId}>Inscribirme</button>
              ) : (
                <button disabled>Grupo lleno</button>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</div>
</Layout>

<script>
import { actions } from "astro:actions";
const buttons = document.querySelectorAll('.joinGroupBtn');
buttons.forEach(button => {
  button.addEventListener('click', async (event) => {
    const groupId = event?.target?.dataset.groupid;
    const token = event?.target?.dataset.token;
    const userId = event?.target?.dataset.userid;
    const { data: response, error: addStudentError } = await actions.user.addStudentToGroup({ token: token as string, group_id: groupId as string, student_id: userId as string });
    // const { data: response, error: addStudentError } = await Astro.callAction(actions.user.addStudentToGroup, { token: token as string, group_id: groupId as string, student_id: userId as string });
    if(addStudentError) {
      alert(addStudentError.message);
    }
    else {
      alert('Alumno inscrito');
      window.location.reload();
    }
  });
});
</script>
