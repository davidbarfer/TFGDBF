---
import Layout from "@/layouts/Layout.astro";
import SubmissionDetails from "@/components/submissions/submissionDetails.astro";
import SumbissionForm from "@/components/submissions/submissionForm.astro";
import { getStudentPracticeSubmission, getSubmissionFile } from "@/utils/users";
import jwt from 'jsonwebtoken'
import { parse } from 'cookie';
import { roles } from "@/consts/users";

const {id:submissionId} = Astro.params;
const cookies = parse(Astro.request.headers.get('cookie') || '');
const token = cookies.token;
const secret = import.meta.env.JWT_SECRET;
let user = null;
if (token) {
  try {
    user = jwt.verify(token, secret); // same secret as backend
  } catch (err) {
    console.warn("Invalid or expired token", err);
  }
}
const submission = await getStudentPracticeSubmission(token as string, user?.userId as string, submissionId as string);
if (submission === null) {
  return Astro.redirect('/404');
}
const submissionFile = await getSubmissionFile(token as string, user?.userId as string, submissionId as string);
if (submissionFile) {
  submission.code = submissionFile;
}
console.log(submissionFile);
---

<Layout>
  <section>
    { (user?.role === roles.student || user?.role === roles.admin || user?.role === roles.professor) ? (
      <h1>Entrega {submissionId} de la práctica {submission.practice_name}</h1>
      <SubmissionDetails submission={submission}/>
      <SumbissionForm submission={submission} />
    ) : (
      <p>No tienes permiso para ver esta página</p>
      <a href="/">Volver al inicio</a>
    )}
  </section>
</Layout>

<style>
  section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: 1rem;
  }
  a {
    text-decoration: none;
    color: var(--color-tertiary);
    text-transform: uppercase;
    font-weight: bold;
    padding: 0.5rem;
    cursor: pointer;
  }
</style>
