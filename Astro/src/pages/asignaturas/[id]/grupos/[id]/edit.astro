---
import { actions } from "astro:actions";
import Layout from "@/layouts/Layout.astro";
import GroupEdit from "@/components/groups/groupEdit.astro";
import jwt from 'jsonwebtoken'
import { parse } from 'cookie';
import { roles } from "@/consts/users";
const { id } = Astro.params;
const cookies = parse(Astro.request.headers.get('cookie') || '');
const token = cookies.token;
const secret = import.meta.env.JWT_SECRET;
let user = null;
if (token) {
  try {
    user = jwt.verify(token, secret); // same secret as backend
  } catch (err) {
    console.warn("Invalid or expired token", err);
  }
}
const { data: group, error } = await Astro.callAction(actions.user.getGroup, { token: token as string, group_id: id as string });
---

<Layout>
  {user?.role === roles.professor || user?.role === roles.admin ? (
    <GroupEdit group={group} token={token} />
  ) : (
    <p>No tienes permiso para editar grupos</p>
    <a href="/">Volver al inicio</a>
  )}
</Layout>
