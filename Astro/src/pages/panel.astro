---
import Layout from "@/layouts/Layout.astro"
import UserStatusList from "@/components/auth/UserStatusList.astro";
import jwt from 'jsonwebtoken'
import { parse } from 'cookie';
import { roles } from "@/consts/users";

const cookies = parse(Astro.request.headers.get('cookie') || '');
const token = cookies.token;
const secret = import.meta.env.JWT_SECRET;
let user = null;
if (token) {
  try {
    user = jwt.verify(token, secret); // same secret as backend
  } catch (err) {
    console.warn("Invalid or expired token", err);
  }
}
const isAdmin = user?.role === roles.admin;
const isProfessor = user?.role === roles.professor;
---

<Layout>
  <article>
    { (isAdmin || isProfessor) ? (
    <h1>Gestionar Asignaturas</h1>
    <section class="btnSection">
        <a href="/asignaturas/asignar" class="btn-primary">Asignar Asignaturas</a>
        <a href="/asignaturas/crear" class="btn-primary">Crear asignatura</a>
        <a href="/asignaturas/eliminar" class="btn-primary">Eliminar asignatura</a>
    </section>
    <section>
      <h1>Profesores pendientes de aprobación</h1>
      <UserStatusList token = {token} role = {roles.professor} />
    </section>
    ) : (
      <p>No tienes permiso para ver esta página</p>
    )}
  </article>
</Layout>

<style>
  article {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    width: 100%;
  }
  .btnSection {
    display: flex;
    flex-direction: row;
    gap: 1rem;
  }
  a {
    text-decoration: none;
    color: var(--color-tertiary);
    text-transform: uppercase;
    font-weight: bold;
    padding: 0.5rem;
    cursor: pointer;
  }
</style>